# Copy to `.env` (git-ignored) to override defaults. Real environment variables always win over this file.
# `npm run dev` needs NO .env at all: it starts a local PostgreSQL and wires everything up.
# This file lists every setting the backend understands. Placeholders only: never commit real secrets.

# --- Server ---------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
# Browser origins allowed to call the API and open WebSockets (exact match, comma separated).
# In production set this to your real site, e.g. https://notes.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
NODE_ENV=development

# --- Database (PostgreSQL) -------------------------------------------------------------------
# Optional in development: when DATABASE_URL is unset (and NODE_ENV is not production) the backend
# uses the local database that `npm run dev:db` starts, so `npm run dev` needs no setup.
# REQUIRED in production. Use a strong, unique password and TLS:
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
# Apply migrations automatically when the server starts (default: yes). Set to false to run
# `npm run migrate` yourself as a separate deploy step.
AUTO_MIGRATE=true

# --- Sessions and passwords -------------------------------------------------------------------
# Send the session cookie over HTTPS only. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
SESSION_TTL_DAYS=14
# scrypt cost (N, a power of two). Higher is slower and stronger. Existing hashes keep verifying
# after you change it, because each hash stores the cost it was made with.
SCRYPT_COST=32768
# Behind a reverse proxy, how many proxy hops to trust for the client IP (rate limiting): 1 for one proxy.
TRUST_PROXY=0
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=600000

# --- Real-time synchronisation ------------------------------------------------------------------
# Largest single WebSocket message (a first sync of a big offline document is one message).
MAX_MESSAGE_BYTES=8388608
MAX_MESSAGES_PER_SECOND=500
# Save a document this long after its last change, but never wait longer than the max-wait.
PERSIST_DEBOUNCE_MS=500
PERSIST_MAX_WAIT_MS=5000
# Keep an empty room in memory this long before evicting it.
ROOM_IDLE_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# --- Version history ---------------------------------------------------------------------------
# Automatic checkpoint when the newest version is older than this (10 minutes)...
AUTO_VERSION_INTERVAL_MS=600000
# ...keeping this many automatic checkpoints per document (saved versions are never pruned).
AUTO_VERSIONS_KEPT=50
